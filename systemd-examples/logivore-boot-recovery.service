# Logivore Boot Recovery Service
# Place this file in /etc/systemd/system/
# Run: systemctl enable logivore-boot-recovery.service

[Unit]
Description=Logivore Boot Recovery Service
After=network.target docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/opt/logivore/scripts/boot-recovery.sh
StandardOutput=journal
StandardError=journal
RemainAfterExit=yes

# Restart on failure
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
