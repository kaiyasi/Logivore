# ===============================================
# Logivore Bot Environment Configuration
# ===============================================

# ===============================================
# Discord Configuration (REQUIRED)
# ===============================================

# Your Discord bot token from https://discord.com/developers/applications
# This is REQUIRED for the bot to function
DISCORD_TOKEN=your_discord_bot_token_here

# Your Discord user ID (for owner commands)
# Right-click your username in Discord and "Copy ID" (requires Developer Mode)
OWNER_ID=your_discord_user_id_here

# ===============================================
# Bot Configuration
# ===============================================

# Default language for new servers (en, zh-tw, zh-cn, ko, ja, de, ru)
DEFAULT_LANGUAGE=en

# Bot command prefix for legacy commands (default: !)
COMMAND_PREFIX=!

# Bot status message
BOT_STATUS=Monitoring systems...

# ===============================================
# System Monitoring Configuration
# ===============================================

# System monitoring update interval in seconds (default: 10)
UPDATE_INTERVAL=10

# Alert check interval in seconds (default: 60)
ALERT_INTERVAL=60

# Maximum uptime days before reboot warning (default: 30)
MAX_UPTIME_DAYS=30

# Monitored disk paths (comma-separated)
MONITORED_DISKS=/,/mnt/data

# Network interfaces to monitor (comma-separated, leave empty for auto-detect)
NETWORK_INTERFACES=

# ===============================================
# Docker Configuration
# ===============================================

# Enable Docker integration (true/false)
DOCKER_ENABLED=true

# Docker socket path (default: unix:///var/run/docker.sock)
DOCKER_HOST=unix:///var/run/docker.sock

# Auto-restart containers on failure (true/false)
DOCKER_AUTO_RESTART=true

# ===============================================
# SSL Certificate Management
# ===============================================

# Enable SSL certificate monitoring (true/false)
SSL_ENABLED=true

# Nginx Proxy Manager configuration
NPM_ENABLED=false
NPM_API_URL=http://localhost:81/api
NPM_EMAIL=admin@example.com
NPM_PASSWORD=changeme

# SSL certificate paths (for manual certificate monitoring)
SSL_CERT_PATH=/etc/letsencrypt/live

# Days before expiry to trigger renewal warning (default: 30)
SSL_RENEWAL_DAYS=30

# ===============================================
# Alert Configuration
# ===============================================

# Enable alert system (true/false)
ALERTS_ENABLED=true

# CPU usage alert threshold percentage (default: 85)
CPU_ALERT_THRESHOLD=85

# Memory usage alert threshold percentage (default: 90)
MEMORY_ALERT_THRESHOLD=90

# Disk usage alert threshold percentage (default: 95)
DISK_ALERT_THRESHOLD=95

# Temperature alert threshold in Celsius (default: 70)
TEMP_ALERT_THRESHOLD=70

# Alert cooldown period in minutes (default: 5)
ALERT_COOLDOWN=5

# Discord channel ID for alerts (optional)
ALERT_CHANNEL_ID=

# Webhook URL for external alerts (optional)
WEBHOOK_URL=

# ===============================================
# Database Configuration
# ===============================================

# Database type (sqlite, postgresql)
DATABASE_TYPE=sqlite

# SQLite database path (if using SQLite)
DATABASE_PATH=data/logivore.db

# PostgreSQL connection URL (if using PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/logivore

# ===============================================
# Logging Configuration
# ===============================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/logivore.log

# Maximum log file size in MB (default: 10)
LOG_MAX_SIZE=10

# Number of backup log files to keep (default: 5)
LOG_BACKUP_COUNT=5

# Enable colored console output (true/false)
LOG_COLORED=true

# ===============================================
# Web Dashboard (Optional)
# ===============================================

# Enable web dashboard (true/false)
WEB_DASHBOARD_ENABLED=false

# Web dashboard host (default: 0.0.0.0)
WEB_DASHBOARD_HOST=0.0.0.0

# Web dashboard port (default: 5000)
WEB_DASHBOARD_PORT=5000

# Web dashboard secret key (generate a random string)
WEB_DASHBOARD_SECRET=your_secret_key_here

# ===============================================
# External API Keys (Optional)
# ===============================================

# Weather API key (for weather monitoring plugin)
WEATHER_API_KEY=

# Other external service API keys
EXTERNAL_API_KEY_1=
EXTERNAL_API_KEY_2=

# ===============================================
# Advanced Configuration
# ===============================================

# Enable debug mode (true/false) - DO NOT use in production
DEBUG_MODE=false

# Performance monitoring (true/false)
PERFORMANCE_MONITORING=false

# Enable metrics collection (true/false)
METRICS_ENABLED=false

# Backup configuration automatically (true/false)
AUTO_BACKUP_CONFIG=true

# Backup retention days (default: 30)
BACKUP_RETENTION_DAYS=30

# ===============================================
# Security Configuration
# ===============================================

# Enable input validation (true/false) - ALWAYS keep true
INPUT_VALIDATION=true

# Enable rate limiting (true/false)
RATE_LIMITING=true

# Maximum commands per minute per user (default: 30)
RATE_LIMIT_COMMANDS=30

# Enable audit logging (true/false)
AUDIT_LOGGING=true

# ===============================================
# Experimental Features (Use with caution)
# ===============================================

# Enable experimental features (true/false)
EXPERIMENTAL_FEATURES=false

# Enable plugin system (true/false)
PLUGIN_SYSTEM=false

# Plugin directory path
PLUGIN_DIRECTORY=plugins

# ===============================================
# Environment-specific Settings
# ===============================================

# Environment name (development, staging, production)
ENVIRONMENT=production

# Time zone (default: UTC)
TIMEZONE=UTC

# ===============================================
# Notes:
# ===============================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit your .env file to version control
# 3. Bot token and owner ID are required - all others are optional
# 4. Boolean values should be 'true' or 'false' (lowercase)
# 5. Numeric values should not have quotes
# 6. String values with spaces should be quoted
# 7. Comment out or remove unused variables
# ===============================================